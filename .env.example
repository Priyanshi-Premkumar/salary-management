# Database Configuration
POSTGRES_DB=compensation_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/compensation_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_postgres_password_here

# Security & JWT
# IMPORTANT: Generate a secure 256-bit or 384-bit key (e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_256bit_secret_key_in_production
JWT_EXPIRATION_MS=86400000

# CORS & Server
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Seeder
SEED_AUTO_RUN=false
